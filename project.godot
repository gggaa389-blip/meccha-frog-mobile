[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="death"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[input_devices]

; [Mobile APK] Real touches stay touches (multi-touch controls);
; taps still emulate mouse so existing menu Buttons keep working.
pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[rendering]

; [Mobile APK] GL Compatibility runs on Android GPUs (was Forward Plus).
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true

[steam]

initialization/app_id=480
initialization/initialize_on_startup=false
initialization/embed_callbacks=false
multiplayer_peer/max_channels=4
