[sub_resource type="GDScript" id="GDScript_cagho"]
script/source = "extends Control

var master_bus_index = AudioServer.get_bus_index(\"Master\")
var music_bus_index = AudioServer.get_bus_index(\"Music\")
var sfx_bus_index = AudioServer.get_bus_index(\"SFX\")
var vc_bus_index = AudioServer.get_bus_index(\"VoiceChat\")

func _ready() -> void:
	AudioServer.set_bus_volume_db(music_bus_index,linear_to_db(Data.data.settings.music_vol))
	AudioServer.set_bus_volume_db(master_bus_index,linear_to_db(Data.data.settings.master_vol))
	AudioServer.set_bus_volume_db(sfx_bus_index,linear_to_db(Data.data.settings.sfx_vol))
	AudioServer.set_bus_volume_db(vc_bus_index,linear_to_db(Data.data.settings.vc_vol))
	$MasterSlider.value = Data.data.settings.master_vol
	$SFXSlider.value = Data.data.settings.sfx_vol
	$MusicSlider.value = Data.data.settings.music_vol
	$MusicSlider.value = .06
	$VCSlider.value = Data.data.settings.vc_vol
	$VCSlider.value = 3.0

func _on_music_slider_value_changed(value: float) -> void:
	AudioServer.set_bus_volume_db(music_bus_index,linear_to_db(value))
	Data.data.settings.music_vol = value
	Data.save()

func _on_master_slider_value_changed(value: float) -> void:
	AudioServer.set_bus_volume_db(master_bus_index,linear_to_db(value))
	Data.data.settings.master_vol = value
	Data.save()

func _on_sfx_slider_value_changed(value: float) -> void:
	AudioServer.set_bus_volume_db(sfx_bus_index,linear_to_db(value))
	Data.data.settings.sfx_vol = value
	Data.save()

func _on_vc_slider_value_changed(value: float) -> void:
	AudioServer.set_bus_volume_db(vc_bus_index,linear_to_db(value))
	Data.data.settings.vc_vol = value
	Data.save()
"

