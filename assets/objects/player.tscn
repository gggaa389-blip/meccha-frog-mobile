[sub_resource type="GDScript" id="GDScript_foeld"]
script/source = "extends AudioStreamPlayer3D


func play_footstep():
	pitch_scale = randf_range(.8, 1.1)
	play()


func _input(event: InputEvent) -> void:
	if Input.is_action_just_pressed('ui_cancel') and name == \"FootstepAudio\":
		play_footstep()
"

[sub_resource type="GDScript" id="GDScript_g7bc3"]
resource_name = "CameraShake3D"
script/source = "extends Camera3D

# Configuration
@export var noise_shake_speed: float = 30.0
@export var noise_shake_strength: float = 60.0
@export var shake_decay_rate: float = 5.0

@export var anim_player: AnimationPlayer

# State
var _noise = FastNoiseLite.new()
var _noise_i: float = 0.0
var _shake_strength: float = 0.0

enum cam_state {NORMAL, PAINT}
var cur_state := cam_state.NORMAL

const EPSILON := 1e-8

@export var my_mesh_instance: MeshInstance3D

var image : Image
var texture: CompressedTexture2D
var editable_texture: ImageTexture

@export var animated_mesh: MeshInstance3D
var baked_mesh: ArrayMesh

var material: StandardMaterial3D

#@export var debug_mesh: MeshInstance3D

var color: Color = Color.RED
var brush_size: int = 1

var paint_on: bool = false

var pose_idx: int = 1

var first_mouse_click: bool = true


func _ready() -> void:
	# Configure the noise for organic randomness
	_noise.seed = randi()
	_noise.frequency = 0.5
	_noise.fractal_octaves = 2
	
	material = my_mesh_instance.get_active_material(0).duplicate()
	my_mesh_instance.material_override = material

	texture = material.albedo_texture
	
	image = texture.get_image()
	if image.is_compressed():
		image.decompress()
	
	editable_texture = ImageTexture.create_from_image(image)
	material.albedo_texture = editable_texture
	
	
	#image.fill(Color.GREEN)
	#editable_texture.update(image)
#
	#animated_mesh.material_override = material


func _process(delta: float) -> void:

	if paint_on and Input.is_mouse_button_pressed(MOUSE_BUTTON_LEFT):
		if first_mouse_click:
			first_mouse_click = false
			return
		var camera = get_viewport().get_camera_3d()

		var mouse = get_viewport().get_mouse_position()

		var origin = camera.project_ray_origin(mouse)
		var dir = camera.project_ray_normal(mouse)

		var result = raycast_mesh_uv(my_mesh_instance, origin, dir)

		if result:
			#image.fill(Color.RED)
			#editable_texture.update(image)
			#return
			#debug_mesh.global_position = result.position
			var x = int(result.uv.x * image.get_width())
			var y = int((result.uv.y) * image.get_height()) # Flip Y if necessary
			print(\"x:%s y:%s\" % [x, y])
			draw_brush.rpc(Vector2i(x, y), brush_size, color)
			#draw_brush(
				#image,
				#Vector2i(image.get_width() / 4, image.get_height() / 4),
				#6400,
				#Color.RED
				#)
			#image.save_png(\"user://paint_test.png\")
			#editable_texture.update(image)
	
	
	if Input.is_action_just_pressed(\"pose\") and paint_on:
		anim_player.play(\"metarig|Pose%s_metarig\" % pose_idx)
		await get_tree().create_timer(.1).timeout
		
		baked_mesh = animated_mesh.bake_mesh_from_current_skeleton_pose()
		my_mesh_instance.mesh = baked_mesh
		
		my_mesh_instance.global_transform = animated_mesh.global_transform
		
		pose_idx += 1
		if pose_idx >= 19:
			pose_idx = 1
	
	if Input.is_action_just_pressed(\"paint_mode\"):
		paint_on = !paint_on
		if !paint_on:
			#animated_mesh.get_active_material(0).albedo_texture = editable_texture
			my_mesh_instance.hide()
			return
		
		anim_player.play(\"metarig|Pose1_metarig\")
		await get_tree().create_timer(.1).timeout
		#return
		baked_mesh = animated_mesh.bake_mesh_from_current_skeleton_pose()
		my_mesh_instance.mesh = baked_mesh
		
		my_mesh_instance.global_transform = animated_mesh.global_transform
		animated_mesh.hide()
		animated_mesh.show()
		

	# Fade out the shake strength over time
	_shake_strength = lerp(_shake_strength, 0.0, shake_decay_rate * delta)
	
	# Apply the shake if there is any strength left
	if _shake_strength > 0.01:
		_apply_shake(delta)
	else:
		# Reset offset when shake is done to ensure camera returns to center
		h_offset = 0.0
		v_offset = 0.0


@rpc(\"any_peer\", \"call_local\", \"reliable\")
func draw_brush(center: Vector2i, radius: int, _color: Color):
	#print(\"draw_brush on peer:\", multiplayer.get_unique_id())

	for y in range(-radius, radius + 1):
		for x in range(-radius, radius + 1):
			if x * x + y * y > radius * radius:
				continue

			var px = center.x + x
			var py = center.y + y

			if px < 0 or py < 0:
				continue
			if px >= image.get_width() or py >= image.get_height():
				continue

			image.set_pixel(px, py, color)
		
	#image.fill(Color.RED)
	editable_texture.update(image)
	animated_mesh.material_override = material


func apply_shake(strength: float = 1.0) -> void:
	# Add to the current strength, clamping to a reasonable maximum
	_shake_strength = clamp(_shake_strength + strength, 0.0, 1.0)

func _apply_shake(delta: float) -> void:
	_noise_i += delta * noise_shake_speed
	
	# Get noise values for X and Y axes
	# We use different offsets (0 and 100) to ensure x and y shake independently
	var offset_x = _noise.get_noise_2d(1, _noise_i) * _shake_strength * noise_shake_strength * delta
	var offset_y = _noise.get_noise_2d(100, _noise_i) * _shake_strength * noise_shake_strength * delta
	
	# Apply to the camera's offset properties
	# Using offset is better than changing position because it doesn't mess up
	# camera movement logic (like following a player)
	h_offset = offset_x
	v_offset = offset_y
	
func hit() -> void:
	apply_shake(.2)

func stop_shake() -> void:
	_shake_strength = 0.0

#func _input(event: InputEvent) -> void:
	#if Input.is_action_just_pressed(\"space\"):
		#$\"../../AnimationPlayer\".play(\"jumpscare\")


func make_area3d():
	var area3d := Area3D.new()
	my_mesh_instance.add_child(area3d)
	
	var collision := CollisionShape3D.new()
	collision.shape = baked_mesh.create_trimesh_shape()
	area3d.add_child(collision)
	

#func draw_brush(image: Image, center: Vector2i, radius: int, color: Color):
#
	#for y in range(-radius, radius + 1):
		#for x in range(-radius, radius + 1):
			#if x * x + y * y > radius * radius:
				#continue
#
			#var px = center.x + x
			#var py = center.y + y
#
			#if px < 0 or py < 0:
				#continue
			#if px >= image.get_width() or py >= image.get_height():
				#continue
#
			#image.set_pixel(px, py, color)



	
		
	

func _input(event: InputEvent) -> void:
	if Input.is_action_just_pressed(\"ui_up\"):
		brush_size += 1
	if Input.is_action_just_pressed(\"ui_down\"):
		brush_size -= 1




## Returns:
## {
##     \"position\": Vector3,
##     \"normal\": Vector3,
##     \"uv\": Vector2,
##     \"distance\": float
## }
##
## or null if no hit.
func raycast_mesh_uv(
		mesh_instance: MeshInstance3D,
		ray_origin: Vector3,
		ray_direction: Vector3
	):

	var mesh := mesh_instance.mesh
	if mesh == null:
		return null

	var inv := mesh_instance.global_transform.affine_inverse()

	var local_origin := inv * ray_origin
	var local_dir := inv.basis * ray_direction
	local_dir = local_dir.normalized()

	var closest_distance := INF
	var closest_result = null

	for surface in mesh.get_surface_count():

		var arrays = mesh.surface_get_arrays(surface)

		var vertices: PackedVector3Array = arrays[Mesh.ARRAY_VERTEX]
		var uvs: PackedVector2Array = arrays[Mesh.ARRAY_TEX_UV]
		var indices: PackedInt32Array = arrays[Mesh.ARRAY_INDEX]

		if uvs.is_empty():
			continue

		if indices.is_empty():

			for i in range(0, vertices.size(), 3):

				var _hit = _intersect_triangle(
					local_origin,
					local_dir,
					vertices[i],
					vertices[i + 1],
					vertices[i + 2]
				)

				if _hit == null:
					continue

				if _hit.distance < closest_distance:

					closest_distance = _hit.distance

					var uv = (
						uvs[i] * _hit.bary.x +
						uvs[i + 1] * _hit.bary.y +
						uvs[i + 2] * _hit.bary.z
					)

					closest_result = {
						\"position\": mesh_instance.global_transform * _hit.position,
						\"normal\": mesh_instance.global_transform.basis * _hit.normal,
						\"uv\": uv,
						\"distance\": _hit.distance
					}

		else:

			for i in range(0, indices.size(), 3):

				var ia = indices[i]
				var ib = indices[i + 1]
				var ic = indices[i + 2]

				var _hit = _intersect_triangle(
					local_origin,
					local_dir,
					vertices[ia],
					vertices[ib],
					vertices[ic]
				)

				if _hit == null:
					continue

				if _hit.distance < closest_distance:

					closest_distance = _hit.distance

					var uv = (
						uvs[ia] * _hit.bary.x +
						uvs[ib] * _hit.bary.y +
						uvs[ic] * _hit.bary.z
					)
					
					#print(\"Triangle:\", ia, ib, ic)
					#print(\"UV0:\", uvs[ia])
					#print(\"UV1:\", uvs[ib])
					#print(\"UV2:\", uvs[ic])
					#print(\"Interpolated:\", uv)

					closest_result = {
						\"position\": mesh_instance.global_transform * _hit.position,
						\"normal\": mesh_instance.global_transform.basis * _hit.normal,
						\"uv\": uv,
						\"distance\": _hit.distance
					}

	return closest_result


func _intersect_triangle(
		origin: Vector3,
		direction: Vector3,
		v0: Vector3,
		v1: Vector3,
		v2: Vector3
	):

	var edge1 = v1 - v0
	var edge2 = v2 - v0

	var h = direction.cross(edge2)
	var a = edge1.dot(h)

	if abs(a) < EPSILON:
		return null

	var f = 1.0 / a
	var s = origin - v0

	var u = f * s.dot(h)

	if u < 0.0 or u > 1.0:
		return null

	var q = s.cross(edge1)
	var v = f * direction.dot(q)

	if v < 0.0 or u + v > 1.0:
		return null

	var t = f * edge2.dot(q)

	if t < 0.0:
		return null

	var w = 1.0 - u - v

	return {
		\"position\": origin + direction * t,
		\"normal\": edge1.cross(edge2).normalized(),
		\"distance\": t,
		\"bary\": Vector3(w, u, v)
	}


func _on_color_picker_color_changed(_color: Color) -> void:
	color = _color
"

