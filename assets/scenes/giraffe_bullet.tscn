[gd_scene format=3 uid="uid://v6atdihmnu1i"]

[ext_resource type="Shader" uid="uid://chxejl0jr2g03" path="res://assets/scenes/giraffe_bullet.gdshader" id="2_gbfoj"]

[sub_resource type="GDScript" id="GDScript_btnnp"]
script/source = "extends Area3D


@export var damage: int = 5
@export var speed: int = 5



func _ready() -> void:
	top_level = true

func _process(delta: float) -> void:
	translate_object_local(Vector3.FORWARD * speed * delta)

func _on_body_entered(body: Node3D) -> void:
	if body.is_in_group(\"player\"):
		body.get_parent().hurt(damage)
	call_deferred(\"queue_free\")


func _on_timer_timeout() -> void:
	call_deferred(\"queue_free\")
"

