[sub_resource type="GDScript" id="GDScript_v5rym"]
script/source = "extends Node3D

var manholes: Array = []


func _ready() -> void:
	manholes = get_tree().get_nodes_in_group(\"manhole\")
	print(manholes.size())

func pick_rnd_manhole() -> Node3D:
	var nbr_of_manholes: int = manholes.size()
	var rnd_manhole: Node3D = manholes[randi() % nbr_of_manholes]
	#return Vector2(rnd_manhole.global_position.x, rnd_manhole.global_position.z)
	return rnd_manhole
"

